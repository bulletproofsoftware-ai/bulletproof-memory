# ==== Ports (host-published) ====
QDRANT_PORT=6334
MEMPG_PORT=5432
OLLAMA_PORT=11434
N8N_PORT=5679
GOVERNANCE_HTTP_PORT=5681
DASHBOARD_PORT=8092
MEMGRAPH_PORT=7687

# ==== Qdrant ====
# API key for Qdrant. A default is provided so the stack works out of the box;
# CHANGE IT for any non-local deployment. All services (init, mcp-server,
# dashboard) read this same value.
QDRANT_API_KEY=bpm-dev-local-key-change-me

# ==== Embeddings ====
EMBED_MODEL=nomic-embed-text

# ==== Postgres (relational tiers + n8n backing store) ====
MEMPG_USER=memory
MEMPG_PASSWORD=memory
MEMPG_DB=memory

# ==== n8n ====
N8N_HOST=localhost
TZ=UTC
# REQUIRED for production — encrypts stored credentials. Generate a random value.
N8N_ENCRYPTION_KEY=changeme-encryption-key
# API key the Claude Memory Gateway webhook validates (x-api-key header)
WEBHOOK_API_KEY=changeme-webhook-key

# ==== MCP server governance HTTP (dedicated key; enables :5681 /tools/call) ====
GOVERNANCE_API_KEY=changeme-governance-key

# ==== Dashboard ====
DASHBOARD_USER=admin
# Salted pbkdf2 hash of your password (the only accepted format):
#   python3 -c "import getpass,hashlib,secrets;p=getpass.getpass();s=secrets.token_hex(16);i=600000;print('pbkdf2_sha256\$'+str(i)+'\$'+s+'\$'+hashlib.pbkdf2_hmac('sha256',p.encode(),bytes.fromhex(s),i).hex())"
# IMPORTANT: docker compose treats "$" in a .env value as variable
# interpolation, which silently truncates the hash and makes every login fail
# with "DASHBOARD_PASS_HASH is malformed". Double each "$" when pasting here:
#   DASHBOARD_PASS_HASH=pbkdf2_sha256$$600000$$<salt>$$<digest>
# Confirm it arrived intact:
#   docker inspect memory-dashboard --format '{{range .Config.Env}}{{println .}}{{end}}' | grep PASS_HASH
DASHBOARD_PASS_HASH=
# Random session secret:     python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
