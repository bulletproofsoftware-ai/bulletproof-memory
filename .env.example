# ==== Ports (host-published) ====
QDRANT_PORT=6334
MEMPG_PORT=5432
OLLAMA_PORT=11434
N8N_PORT=5679
GOVERNANCE_HTTP_PORT=5681
DASHBOARD_PORT=8092
MEMGRAPH_PORT=7687

# ==== Qdrant ====
# API key for Qdrant. A default is provided so the stack works out of the box;
# CHANGE IT for any non-local deployment. All services (init, mcp-server,
# dashboard) read this same value.
QDRANT_API_KEY=bpm-dev-local-key-change-me

# ==== Embeddings ====
EMBED_MODEL=nomic-embed-text

# ==== Postgres (relational tiers + n8n backing store) ====
MEMPG_USER=memory
MEMPG_PASSWORD=memory
MEMPG_DB=memory

# ==== n8n ====
N8N_HOST=localhost
TZ=UTC
# REQUIRED for production — encrypts stored credentials. Generate a random value.
N8N_ENCRYPTION_KEY=changeme-encryption-key

# ==== MCP server governance HTTP (dedicated key; enables :5681 /tools/call) ====
GOVERNANCE_API_KEY=changeme-governance-key

# ==== Dashboard ====
DASHBOARD_USER=admin
# SHA-256 of your password:  python3 -c "import hashlib;print(hashlib.sha256('pw'.encode()).hexdigest())"
DASHBOARD_PASS_HASH=
# Random session secret:     python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
