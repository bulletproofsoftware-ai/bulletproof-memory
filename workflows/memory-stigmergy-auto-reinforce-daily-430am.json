{
  "nodes": [
    {
      "id": "schedule",
      "name": "Daily 4:30AM",
      "parameters": {
        "rule": {
          "interval": [
            {
              "expression": "30 4 * * *",
              "field": "cronExpression"
            }
          ]
        }
      },
      "position": [
        0,
        300
      ],
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2
    },
    {
      "id": "scroll_trajectories",
      "name": "Scroll Trajectories",
      "parameters": {
        "contentType": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.QDRANT_API_KEY }}"
            }
          ]
        },
        "jsonBody": "{\"limit\":100,\"with_payload\":true,\"with_vector\":false}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "keypair",
        "url": "http://qdrant:6333/collections/trajectories/points/scroll"
      },
      "position": [
        220,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "extract_chains",
      "name": "Extract Tool Chains",
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst trajectories = response.result?.points || [];\nconst now = Date.now();\nconst recentWindow = 48 * 60 * 60 * 1000;\nconst chains = [];\n\nfor (const t of trajectories) {\n  const p = t.payload || {};\n  const created = new Date(p.started_at || p.created_at || 0).getTime();\n  if ((now - created) > recentWindow) continue;\n  \n  const tools = p.tools_used || [];\n  if (tools.length < 2) continue;\n  \n  chains.push({\n    tool_chain: tools,\n    task_context: (p.task || '').substring(0, 200),\n    project: p.project || 'unknown',\n    success: p.status === 'completed'\n  });\n}\n\nif (chains.length === 0) {\n  return [{ json: { _empty: true, chain_count: 0 } }];\n}\n\nreturn chains.map(c => ({ json: { ...c, _empty: false } }));",
        "mode": "runOnceForAllItems"
      },
      "position": [
        440,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "has_chains",
      "name": "Has Chains",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json._empty }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      },
      "position": [
        660,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
    {
      "id": "loop",
      "name": "Loop Chains",
      "parameters": {
        "batchSize": 1
      },
      "position": [
        880,
        400
      ],
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3
    },
    {
      "id": "embed_chain",
      "name": "Embed Chain",
      "parameters": {
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({model:'nomic-embed-text', prompt: $json.tool_chain.join(' -> ') + ' for ' + $json.task_context}) }}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "url": "http://ollama:11434/api/embeddings"
      },
      "position": [
        1100,
        400
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "build_trail",
      "name": "Build Trail Point",
      "parameters": {
        "jsCode": "const embedding = $json.embedding;\nconst chain = $('Loop Chains').first().json;\nif (!embedding || !chain.tool_chain) return { json: { _skip: true } };\n\nconst uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n  const r = Math.random() * 16 | 0;\n  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n});\n\nreturn {\n  json: {\n    point: {\n      id: uuid,\n      vector: embedding,\n      payload: {\n        tool_chain: chain.tool_chain,\n        task_context: chain.task_context,\n        project: chain.project,\n        pheromone_strength: chain.success ? 1.0 : 0.3,\n        reinforcement_count: 1,\n        created_at: new Date().toISOString(),\n        last_reinforced: new Date().toISOString(),\n        source: 'auto_trajectory'\n      }\n    }\n  }\n};",
        "mode": "runOnceForEachItem"
      },
      "position": [
        1320,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "store_trail",
      "name": "Store Trail",
      "parameters": {
        "contentType": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.QDRANT_API_KEY }}"
            }
          ]
        },
        "jsonBody": "={{ JSON.stringify({points:[$json.point]}) }}",
        "method": "PUT",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "keypair",
        "url": "http://qdrant:6333/collections/pheromone_trails/points"
      },
      "position": [
        1540,
        400
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "summary",
      "name": "Summary",
      "parameters": {
        "jsCode": "return [{ json: { reinforced: 0, skipped: 'no recent trajectories' } }];",
        "mode": "runOnceForAllItems"
      },
      "position": [
        880,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "webhook",
      "name": "Webhook Trigger",
      "parameters": {
        "httpMethod": "POST",
        "path": "stigmergy-reinforce",
        "responseMode": "onReceived"
      },
      "position": [
        0,
        500
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "b672ab42-a72a-474c-8eee-783fc9976458"
    }
  ],
