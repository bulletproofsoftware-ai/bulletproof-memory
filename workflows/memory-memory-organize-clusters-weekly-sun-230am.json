{
  "nodes": [
    {
      "id": "schedule",
      "name": "Weekly Sun 2:30AM",
      "parameters": {
        "rule": {
          "interval": [
            {
              "expression": "30 2 * * 0",
              "field": "cronExpression"
            }
          ]
        }
      },
      "position": [
        0,
        300
      ],
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2
    },
    {
      "id": "call_cluster",
      "name": "Call Organize Cluster",
      "parameters": {
        "contentType": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.QDRANT_API_KEY }}"
            }
          ]
        },
        "jsonBody": "{\"tool\":\"memory_organize\",\"args\":{\"operation\":\"cluster\",\"query\":\"all recent memories\"}}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "keypair",
        "url": "http://mcp-server:5681/tools/call"
      },
      "position": [
        220,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "call_prune",
      "name": "Call Organize Prune",
      "parameters": {
        "contentType": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.QDRANT_API_KEY }}"
            }
          ]
        },
        "jsonBody": "{\"tool\":\"memory_organize\",\"args\":{\"operation\":\"prune\",\"criteria\":{\"older_than_days\":180,\"score_below\":0.3,\"access_count_below\":0}}}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "keypair",
        "url": "http://mcp-server:5681/tools/call"
      },
      "position": [
        440,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "parse_result",
      "name": "Combine Results",
      "parameters": {
        "jsCode": "const clusterRaw = $('Call Organize Cluster').first().json;\nconst pruneRaw = $input.first().json;\nconst cluster = clusterRaw.content || clusterRaw.result || clusterRaw;\nconst prune = pruneRaw.content || pruneRaw.result || pruneRaw;\nconst clusterStr = typeof cluster === 'string' ? cluster : JSON.stringify(cluster).substring(0, 300);\nconst pruneStr = typeof prune === 'string' ? prune : JSON.stringify(prune).substring(0, 300);\n\nreturn [{ json: {\n  action: 'MEMORY_ORGANIZE',\n  tool: 'memory_organize',\n  cluster_summary: clusterStr,\n  prune_summary: pruneStr,\n  summary: 'Cluster: ' + clusterStr.substring(0, 200) + ' | Prune: ' + pruneStr.substring(0, 200),\n  timestamp: new Date().toISOString(),\n  source: 'n8n_scheduled'\n}}];",
        "mode": "runOnceForAllItems"
      },
      "position": [
        660,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "embed_audit",
      "name": "Embed Audit",
      "parameters": {
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({model:'nomic-embed-text', prompt: 'memory organize cluster prune weekly ' + $json.summary.substring(0, 200)}) }}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "url": "http://ollama:11434/api/embeddings"
      },
      "position": [
        880,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "build_audit",
      "name": "Build Audit Point",
      "parameters": {
        "jsCode": "const embedding = $json.embedding;\nconst parsed = $('Combine Results').first().json;\nif (!embedding) return { json: { error: 'no embedding' } };\n\nconst uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n  const r = Math.random() * 16 | 0;\n  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n});\n\nreturn {\n  json: {\n    point: {\n      id: uuid,\n      vector: embedding,\n      payload: {\n        action: parsed.action,\n        tool: parsed.tool,\n        cluster_summary: parsed.cluster_summary,\n        prune_summary: parsed.prune_summary,\n        timestamp: parsed.timestamp,\n        source: parsed.source\n      }\n    }\n  }\n};",
        "mode": "runOnceForEachItem"
      },
      "position": [
        1100,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "store_audit",
      "name": "Store Audit",
      "parameters": {
        "contentType": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.QDRANT_API_KEY }}"
            }
          ]
        },
        "jsonBody": "={{ JSON.stringify({points:[$json.point]}) }}",
        "method": "PUT",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "keypair",
        "url": "http://qdrant:6333/collections/audit_log/points"
      },
      "position": [
        1320,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    }
  ],
  "connections": {
    "Build Audit Point": {
