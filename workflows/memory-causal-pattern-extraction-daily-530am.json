    },
    {
      "id": "scroll_audit",
      "name": "Scroll Error Events",
      "parameters": {
        "contentType": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.QDRANT_API_KEY }}"
            }
          ]
        },
        "jsonBody": "{\"limit\":500,\"with_payload\":true,\"with_vector\":false}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "keypair",
        "url": "http://qdrant:6333/collections/audit_log/points/scroll"
      },
      "position": [
        220,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "group_errors",
      "name": "Group Error Patterns",
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst points = response.result?.points || [];\nconst errorMap = new Map();\nconst weekAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;\n\nfor (const p of points) {\n  const payload = p.payload || {};\n  const action = payload.action || '';\n  const error = payload.error || payload.error_message || '';\n  const ts = new Date(payload.timestamp || 0).getTime();\n  \n  if (!error || ts < weekAgo) continue;\n  \n  // Group by action + first 100 chars of error\n  const key = action + '::' + error.substring(0, 100);\n  if (!errorMap.has(key)) {\n    errorMap.set(key, {\n      action: action,\n      error_pattern: error.substring(0, 200),\n      occurrences: 0,\n      first_seen: payload.timestamp,\n      last_seen: payload.timestamp,\n      projects: new Set()\n    });\n  }\n  const e = errorMap.get(key);\n  e.occurrences++;\n  e.last_seen = payload.timestamp;\n  if (payload.project) e.projects.add(payload.project);\n}\n\n// Only patterns with 2+ occurrences\nconst patterns = Array.from(errorMap.values())\n  .filter(e => e.occurrences >= 2)\n  .map(e => ({ ...e, projects: Array.from(e.projects) }));\n\nif (patterns.length === 0) {\n  return [{ json: { _empty: true } }];\n}\nreturn patterns.map(p => ({ json: { ...p, _empty: false } }));",
        "mode": "runOnceForAllItems"
      },
      "position": [
        440,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "has_patterns",
      "name": "Has Patterns",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json._empty }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      },
      "position": [
        660,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
    {
      "id": "loop",
      "name": "Loop Patterns",
      "parameters": {
