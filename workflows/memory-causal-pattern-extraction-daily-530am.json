    {
      "id": "embed",
      "name": "Embed Pattern",
      "parameters": {
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({model:'nomic-embed-text', prompt: 'error pattern: ' + $json.action + ' ' + $json.error_pattern}) }}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "url": "http://ollama:11434/api/embeddings"
      },
      "position": [
        1100,
        400
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "build_point",
      "name": "Build Analysis Point",
      "parameters": {
        "jsCode": "const embedding = $json.embedding;\nconst pattern = $('Loop Patterns').first().json;\nif (!embedding) return { json: { _skip: true } };\n\nconst uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n  const r = Math.random() * 16 | 0;\n  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n});\n\nreturn {\n  json: {\n    point: {\n      id: uuid,\n      vector: embedding,\n      payload: {\n        analysis_type: 'error_pattern',\n        action: pattern.action,\n        error_pattern: pattern.error_pattern,\n        occurrences: pattern.occurrences,\n        first_seen: pattern.first_seen,\n        last_seen: pattern.last_seen,\n        affected_projects: pattern.projects,\n        severity: pattern.occurrences >= 10 ? 'high' : pattern.occurrences >= 5 ? 'medium' : 'low',\n        created_at: new Date().toISOString(),\n        source: 'auto_audit_extraction'\n      }\n    }\n  }\n};",
        "mode": "runOnceForEachItem"
      },
      "position": [
        1320,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "store_point",
      "name": "Store Causal Analysis",
