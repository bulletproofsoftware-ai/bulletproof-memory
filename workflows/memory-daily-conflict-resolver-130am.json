    {
      "id": "scroll_memories",
      "name": "Scroll All Memories",
      "parameters": {
        "authentication": "none",
        "contentType": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.QDRANT_API_KEY }}"
            }
          ]
        },
        "jsonBody": "{\"limit\":500,\"with_payload\":true,\"with_vector\":false}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "keypair",
        "url": "http://qdrant:6333/collections/claude_memories/points/scroll"
      },
      "position": [
        220,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "prepare",
      "name": "Prepare for Analysis",
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst memories = response.result?.points || [];\nif (!memories.length) return [{ json: { _empty: true, prompt: '', total_memories: 0 } }];\n\nconst groups = {};\nfor (const m of memories) {\n  const p = m.payload || {};\n  if (p.status === 'pruned' || p.status === 'archived') continue;\n  const key = (p.project || 'global') + '/' + (p.type || 'unknown');\n  if (!groups[key]) groups[key] = [];\n  groups[key].push({\n    id: m.id,\n    content: (p.content || '').slice(0, 400),\n    type: p.type,\n    project: p.project || 'global',\n    created: p.created_at,\n    tags: (p.tags || []).join(','),\n    status: p.status || 'active',\n    relevance: p.relevance_score || 1.0\n  });\n}\n\nlet prompt = 'You are a memory hygiene analyst for a persistent AI memory system. Below are memories grouped by project/type.\\n\\n';\nprompt += 'Find HIGH CONFIDENCE issues only:\\n';\nprompt += '1. CONTRADICTIONS: Two memories that directly conflict about the same topic\\n';\nprompt += '2. DUPLICATES: Memories saying essentially the same thing (not just related)\\n';\nprompt += '3. SUPERSEDED: Older memories made obsolete by newer ones on the same topic\\n\\n';\n\nlet activeCount = 0;\nfor (const [group, mems] of Object.entries(groups)) {\n  prompt += `--- ${group} (${mems.length}) ---\\n`;\n  for (const m of mems) {\n    prompt += `[${m.id}] (${m.created || '?'} | rel:${m.relevance}) ${m.content}\\n`;\n    activeCount++;\n  }\n  prompt += '\\n';\n}\n\nprompt += '\\nRespond with ONLY a JSON array. Each element:\\n';\nprompt += '{\"action\":\"tag_outdated\"|\"tag_duplicate\"|\"tag_conflict\",\"memory_id\":\"<id>\",\"reason\":\"<brief explanation>\",\"related_id\":\"<id of the newer/conflicting memory>\",\"confidence\":\"high\"|\"medium\"}\\n';\nprompt += 'Only include HIGH confidence findings. If nothing found, return []\\n';\nprompt += 'For duplicates, tag the OLDER one. For conflicts, tag the one that appears wrong or outdated.';\n\nreturn [{ json: { _empty: false, prompt, total_memories: activeCount, groups: Object.keys(groups).length } }];",
        "mode": "runOnceForAllItems"
      },
      "position": [
        440,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "check_empty_scroll",
      "name": "Has Memories",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "check-empty",
              "leftValue": "={{ $json._empty }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        },
        "options": {}
      },
      "position": [
        660,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
    {
      "id": "log_no_memories",
      "name": "Log No Memories",
      "parameters": {
        "jsCode": "return [{ json: { status: 'skipped', reason: 'no active memories found', actions: 0 } }];",
        "mode": "runOnceForAllItems"
      },
      "position": [
        880,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "claude_analyze",
      "name": "Claude Analyze Conflicts",
      "parameters": {
        "authentication": "none",
        "contentType": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "jsonBody": "={{ JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:4096,messages:[{role:'user',content:$json.prompt}]}) }}",
        "method": "POST",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "keypair",
        "url": "https://api.anthropic.com/v1/messages"
      },
      "position": [
        880,
        400
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "parse_actions",
      "name": "Parse Actions",
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst text = response.content?.[0]?.text || '[]';\n\nlet actions = [];\ntry {\n  const match = text.match(/\\[[\\s\\S]*\\]/);\n  if (match) actions = JSON.parse(match[0]);\n} catch (e) {\n  return [{ json: { _empty: true, error: e.message, raw: text.slice(0, 500), total_actions: 0 } }];\n}\n\nif (!actions.length) {\n  return [{ json: { _empty: true, total_actions: 0 } }];\n}\n\n// Filter to high confidence only\nconst highConf = actions.filter(a => a.confidence !== 'low');\nif (!highConf.length) {\n  return [{ json: { _empty: true, total_actions: 0, filtered_out: actions.length } }];\n}\n\nreturn highConf.map(a => ({\n  json: { ...a, _empty: false, total_actions: highConf.length }\n}));",
        "mode": "runOnceForAllItems"
      },
      "position": [
        1100,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "has_actions",
      "name": "Has Actions",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "check-actions",
              "leftValue": "={{ $json._empty }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        },
        "options": {}
      },
      "position": [
        1320,
        400
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
