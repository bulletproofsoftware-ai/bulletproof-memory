      "typeVersion": 3
    },
    {
      "id": "embed",
      "name": "Embed Lifecycle",
      "parameters": {
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({model:'nomic-embed-text', prompt: 'NHI lifecycle: ' + $json.name + ' status=' + $json.lifecycle_status + ' weekly=' + $json.weekly_actions + ' monthly=' + $json.monthly_actions}) }}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "url": "http://ollama:11434/api/embeddings"
      },
      "position": [
        1100,
        400
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "build_point",
      "name": "Build Lifecycle Point",
      "parameters": {
        "jsCode": "const embedding = $json.embedding;\nconst lc = $('Loop Identities').first().json;\nif (!embedding) return { json: { _skip: true } };\n\nconst uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n  const r = Math.random() * 16 | 0;\n  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n});\n\nreturn {\n  json: {\n    point: {\n      id: uuid,\n      vector: embedding,\n      payload: {\n        identity_id: lc.identity_id,\n        name: lc.name,\n        lifecycle_status: lc.lifecycle_status,\n        weekly_actions: lc.weekly_actions,\n        monthly_actions: lc.monthly_actions,\n        last_action: lc.last_action,\n        last_active: lc.last_active,\n        assessed_at: new Date().toISOString(),\n        source: 'auto_lifecycle_tracker'\n      }\n    }\n  }\n};",
        "mode": "runOnceForEachItem"
      },
      "position": [
        1320,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "store_point",
