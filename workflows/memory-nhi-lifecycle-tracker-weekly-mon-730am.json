      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "scroll_audit",
      "name": "Scroll Recent Audit",
      "parameters": {
        "contentType": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.QDRANT_API_KEY }}"
            }
          ]
        },
        "jsonBody": "{\"limit\":500,\"with_payload\":true,\"with_vector\":false}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "keypair",
        "url": "http://qdrant:6333/collections/audit_log/points/scroll"
      },
      "position": [
        220,
        500
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "compute_lifecycle",
      "name": "Compute Lifecycle Stats",
      "parameters": {
        "jsCode": "const identities = $('Scroll Identities').first().json.result?.points || [];\nconst auditPoints = $('Scroll Recent Audit').first().json.result?.points || [];\n\nconst weekAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;\nconst monthAgo = Date.now() - 30 * 24 * 60 * 60 * 1000;\n\n// Build activity map from audit\nconst activityMap = new Map();\nfor (const p of auditPoints) {\n  const payload = p.payload || {};\n  const caller = payload.caller || payload.agent_name || '';\n  if (!caller) continue;\n  if (!activityMap.has(caller)) activityMap.set(caller, { weekly: 0, monthly: 0, last_action: '', last_ts: '' });\n  const a = activityMap.get(caller);\n  const ts = new Date(payload.timestamp || 0).getTime();\n  if (ts > weekAgo) a.weekly++;\n  if (ts > monthAgo) a.monthly++;\n  if (!a.last_ts || payload.timestamp > a.last_ts) {\n    a.last_ts = payload.timestamp;\n    a.last_action = payload.action || '';\n  }\n}\n\nconst results = identities.map(i => {\n  const name = i.payload?.name || i.payload?.agent_name || '';\n  const activity = activityMap.get(name) || { weekly: 0, monthly: 0, last_action: 'none', last_ts: '' };\n  let status = 'active';\n  if (activity.weekly === 0 && activity.monthly === 0) status = 'dormant';\n  else if (activity.weekly === 0) status = 'inactive';\n  \n  return {\n    identity_id: i.id,\n    name: name,\n    lifecycle_status: status,\n    weekly_actions: activity.weekly,\n    monthly_actions: activity.monthly,\n    last_action: activity.last_action,\n    last_active: activity.last_ts\n  };\n});\n\nif (results.length === 0) return [{ json: { _empty: true } }];\nreturn results.map(r => ({ json: { ...r, _empty: false } }));",
        "mode": "runOnceForAllItems"
      },
      "position": [
        440,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "has_results",
      "name": "Has Results",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json._empty }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      },
      "position": [
        660,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
    {
      "id": "loop",
      "name": "Loop Identities",
      "parameters": {
        "batchSize": 1
