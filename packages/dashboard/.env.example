# --- Dashboard auth ---
# Login username for the dashboard.
DASHBOARD_USER=admin
# SHA-256 hash of the login password (NOT the plaintext). Generate with:
#   python3 -c "import hashlib; print(hashlib.sha256('yourpassword'.encode()).hexdigest())"
DASHBOARD_PASS_HASH=
# Secret for signing session cookies. Generate a random value:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random secret is generated per process (sessions won't survive restarts).
SESSION_SECRET=

# --- Qdrant (vector backend the dashboard reads) ---
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=

# --- Ollama (embeddings for semantic search from the UI) ---
OLLAMA_URL=http://localhost:11434

# --- Decisions log (Postgres-backed decisions table) ---
DECISIONS_PG_HOST=localhost
DECISIONS_PG_PORT=5432
DECISIONS_PG_USER=postgres
DECISIONS_PG_PASSWORD=
DECISIONS_PG_DB=postgres

# --- claude-memory Postgres (COLD tier / episodes / transcripts) ---
MEMPG_HOST=localhost
MEMPG_PORT=5432
MEMPG_USER=memory
MEMPG_PASSWORD=
MEMPG_DB=memory

# --- Optional integrations (leave blank/unset to disable the health probe) ---
# Full health URL for an n8n instance, e.g. http://localhost:5678/healthz
N8N_HEALTH_URL=
# Memgraph (graph pages). Defaults target a Docker host.
MEMGRAPH_HOST=host.docker.internal
MEMGRAPH_PORT=7687

# --- Config file path (optional; defaults to bundled config.yaml) ---
CONFIG_PATH=
