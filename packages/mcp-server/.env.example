# --- Qdrant (vector backend) ---
# HTTP endpoint for your Qdrant instance.
QDRANT_URL=http://localhost:6334
# API key for Qdrant. Leave blank for a local unauthenticated instance.
QDRANT_API_KEY=

# --- Ollama (embeddings) ---
# Endpoint for the Ollama server that produces embeddings.
OLLAMA_URL=http://localhost:11434
# Embedding model (must be pulled in Ollama). 768-dim.
EMBED_MODEL=nomic-embed-text

# --- PostgreSQL (COLD tier, episodes, transcripts, audit) ---
CLAUDE_MEMORY_PG_HOST=localhost
CLAUDE_MEMORY_PG_PORT=5432
CLAUDE_MEMORY_PG_USER=memory
CLAUDE_MEMORY_PG_DB=memory
CLAUDE_MEMORY_PG_PASSWORD=

# --- Memgraph (optional graph links) ---
# bolt://localhost:7687
MEMGRAPH_URL=
