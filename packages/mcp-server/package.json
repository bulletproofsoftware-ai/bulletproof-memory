{
  "name": "bulletproof-memory",
  "version": "1.0.0",
  "description": "MCP server for persistent, tiered agent memory with semantic recall over Qdrant + Postgres",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bulletproof-memory": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "self-test": "tsx scripts/self-test.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.11.1",
    "neo4j-driver": "^5.28.3",
    "zod": "^3.23.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "semantic-search",
    "vector-database",
    "qdrant",
    "agent-memory"
  ],
  "author": "bulletproofsoftware-ai",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bulletproofsoftware-ai/bulletproof-memory.git"
  },
  "homepage": "https://github.com/bulletproofsoftware-ai/bulletproof-memory#readme",
  "bugs": {
    "url": "https://github.com/bulletproofsoftware-ai/bulletproof-memory/issues"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  }
}
